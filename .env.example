# Supabase Configuration
# Obtain these from your Supabase project settings at https://supabase.com/dashboard/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key-here

# Required for secure account deletion. Keep this server-only; never prefix it with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# App URL (used for Auth redirects)
NEXT_PUBLIC_APP_URL=http://localhost:3000
